# GEMINI_API_KEY: Required for Gemini AI API calls.
# WEATHER_API_KEY: Required for Weather API (OpenWeatherMap).
# Users configure these via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the lines below if your app uses these APIs.
GEMINI_API_KEY=MY_GEMINI_API_KEY
WEATHER_API_KEY=YOUR_OPENWEATHER_KEY
